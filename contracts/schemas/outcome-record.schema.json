{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ana-agents.invalid/contracts/v1/outcome-record.schema.json",
  "title": "OutcomeRecord",
  "description": "Terminal or learning outcome of one lead. It may follow any stop outcome. No artifact type may take an OutcomeRecord as input, so it can never feed back into sending. Learning notes are hypotheses for controlled human review, never automatic prompt or policy changes.",
  "x-ana-kind": "pipeline",
  "type": "object",
  "allOf": [{ "$ref": "artifact-envelope.schema.json" }],
  "properties": {
    "artifact_type": { "const": "OutcomeRecord" },
    "schema_version": { "const": "1.0.0" },
    "outcome": {
      "enum": [
        "REJECTED_AT_TRIAGE",
        "DEFERRED_AT_TRIAGE",
        "INSUFFICIENT_EVIDENCE",
        "CONFLICTING_EVIDENCE",
        "NO_FIT",
        "CONTACT_NOT_READY",
        "COMMERCIAL_NOT_VIABLE",
        "NOT_APPROVED",
        "SEND_NOT_AUTHORIZED",
        "SENT_NO_REPLY",
        "REPLIED",
        "BOUNCED",
        "OPTED_OUT"
      ]
    },
    "recorded_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "learning_hypotheses": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/non_empty_text" }
    }
  },
  "required": ["outcome", "recorded_at", "learning_hypotheses"],
  "unevaluatedProperties": false
}
