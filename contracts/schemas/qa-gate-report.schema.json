{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ana-agents.invalid/contracts/v1/qa-gate-report.schema.json",
  "title": "QAGateReport",
  "description": "Quality gate over one exact draft (bound by draft_hash). Hard checks cannot be compensated by soft scores: any hard check not PASS forces overall NOT_READY (semantic rule). A semantic check may only report PASS/FAIL with execution evidence (EVAL-006).",
  "x-ana-kind": "pipeline",
  "type": "object",
  "allOf": [{ "$ref": "artifact-envelope.schema.json" }],
  "properties": {
    "artifact_type": { "const": "QAGateReport" },
    "schema_version": { "const": "1.0.0" },
    "draft_hash": { "$ref": "common.schema.json#/$defs/draft_hash" },
    "hard_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "check_id": { "$ref": "common.schema.json#/$defs/identifier" },
          "kind": { "enum": ["deterministic", "semantic"] },
          "result": { "$ref": "common.schema.json#/$defs/execution_result" }
        },
        "required": ["check_id", "kind", "result"],
        "additionalProperties": false
      }
    },
    "soft_scores": {
      "description": "Advisory quality signals. They never override a hard check.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/non_empty_text" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["name", "score"],
        "additionalProperties": false
      }
    },
    "overall": { "enum": ["READY_FOR_HUMAN_REVIEW", "NOT_READY"] }
  },
  "required": ["draft_hash", "hard_checks", "soft_scores", "overall"],
  "unevaluatedProperties": false
}
